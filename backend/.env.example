PGHOST=localhost
PGPORT=5432
PGDATABASE=cnpj
PGUSER=postgres
PGPASSWORD=sua_senha_aqui
PORT=3001
PORTAL_TRANSPARENCIA_API_KEY=sua_chave_aqui

# Auth (V1) — gere um valor forte, nunca use este de exemplo em produção.
JWT_SECRET=gere_um_valor_aleatorio_forte_aqui
# 30.000 é um valor testado nesta sprint: com os JOINs de enriquecimento,
# fica em ~15s de execução, com margem segura dentro do timeout do export
# (45s). Não subir sem medir de novo — 100.000 estourava o timeout.
DEFAULT_LEAD_EXPORT_MAX_ROWS=1000
DEFAULT_ACCOUNT_EXPORT_MAX_ROWS=30000
